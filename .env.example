# Copy this file to `.env` and fill in what you need. Every key here is
# optional: with none of them set the app runs fully, just without the
# features they unlock.

# --- Chatbot -------------------------------------------------------------
# Optional — enables real AI answers in the chat-ball widget (chatbot_feature/).
# Get a free key at https://aistudio.google.com/apikey
# Leave unset and the widget falls back to its built-in FAQ, no network needed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Google sign-in ------------------------------------------------------
# Optional — without it the app runs exactly as before: every visitor stays
# anonymous and the sign-in button is replaced by a note saying it is off.
# See "Google sign-in" in README.md for the Google Cloud Console steps.
#
# The client id is NOT a secret — it ships in the page. This flow uses Google
# Identity Services, which returns a signed ID token, so there is no client
# secret to store anywhere.
GOOGLE_CLIENT_ID=

# --- Optional overrides --------------------------------------------------
# PORT=4000
# AUTH_DATA_DIR=./server/data
