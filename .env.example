# Copy this file to `.env` and fill in what you need. Every key here is
# optional: with none of them set the app runs fully, just without the
# features they unlock.

# --- Chatbot -------------------------------------------------------------
# Optional — enables real AI answers in the chat-ball widget (chatbot_feature/).
# Get a free key at https://aistudio.google.com/apikey
# Leave unset and the widget falls back to its built-in FAQ, no network needed.
GEMINI_API_KEY=
# Any Gemini Flash-class model id; check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash

# --- Optional overrides --------------------------------------------------
# PORT=4000

# Postgres connection for accounts and progress (see README)
DATABASE_URL=postgresql://kickstart_user:your-password@localhost:5432/kickstart
